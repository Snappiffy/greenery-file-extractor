# Shared secret the worker sends as Bearer token. Minimum 32 characters.
# REQUIRED — override in every environment.
EXTRACTOR_SHARED_SECRET=

# Comma-separated allowlist of hosts the fetcher may download from (R2/S3).
# REQUIRED — exact hostnames only (no https://, no path, no wildcards).
# Cloudflare R2 signed URLs are virtual-hosted:
#   {bucket}.{accountId}.r2.cloudflarestorage.com
# Put that host (and optionally the bare account host) here.
# Example:
#   greenery-test.abc123.r2.cloudflarestorage.com,abc123.r2.cloudflarestorage.com
FETCH_ALLOWED_HOSTS=

# development | staging | production
ENVIRONMENT=development

LOG_LEVEL=INFO

MAX_REQUEST_BYTES=52428800
MAX_DOCUMENT_BYTES=52428800
MAX_PAGES=200
MAX_CONCURRENCY=4
EXTRACTION_TIMEOUT_SECONDS=120
FETCH_TIMEOUT_SECONDS=30

OCR_ENABLED=false
OCR_DENSITY_THRESHOLD=5.0
OCR_MIN_CONFIDENCE=70
TESSERACT_CMD=tesseract

UVICORN_WORKERS=2
